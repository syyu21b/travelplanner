{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelplanner",
  "main": "server/worker.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Vercel에 배포한 api/plan-trip.ts 함수 URL (지역 차단 우회용 프록시)
  // NAVER_CLIENT_ID/KAKAO_CLIENT_ID는 공개 가능한 OAuth Client ID — 실제 값을 발급받으면 채울 것.
  // Client Secret은 절대 여기 넣지 말 것: 로컬은 .dev.vars, 배포본은 `wrangler secret put`으로 등록.
  "vars": {
    "PLAN_TRIP_PROXY_URL": "https://travelplanner-syyu21b.vercel.app/api/plan-trip",
    "NAVER_CLIENT_ID": "oIprsolL0m8giBgq629e",
    "KAKAO_CLIENT_ID": "9fab0a92f782b05f60392f79960378e9",
    "PORTONE_STORE_ID": "",
    "PORTONE_CHANNEL_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travelplanner-db",
      "database_id": "7609bd67-fa4b-4cd5-a8c9-658c2d4c014a",
      "migrations_dir": "server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "travelplanner-media"
    }
  ],
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
