{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelplanner",
  "main": "server/worker.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Vercel에 배포한 api/plan-trip.ts 함수 URL (지역 차단 우회용 프록시)
  "vars": {
    "PLAN_TRIP_PROXY_URL": "https://travelplanner-syyu21b.vercel.app/api/plan-trip"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travelplanner-db",
      "database_id": "7609bd67-fa4b-4cd5-a8c9-658c2d4c014a",
      "migrations_dir": "server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "travelplanner-media"
    }
  ],
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
